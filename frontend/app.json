{
  "expo": {
    "name": "VinWatch",
    "slug": "vinwatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "vinwatch",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": { "supportsTablet": false },
    "android": { "edgeToEdgeEnabled": true },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "VINWatch needs your camera to scan VIN barcodes." }]
    ]
  }
}